// A 60-card deck built only from verified real cards (decisions.md D-038): white Angels
// with black card draw. Needs the Scryfall cache (`harness fetch-cards`).
DeckFile(
    name: "Angels (real cards)",
    cards: [
        (13, "Plains"), (7, "Swamp"), (2, "Radiant Fountain"), (2, "Seraph Sanctuary"),
        (2, "Marble Diamond"),
        (4, "Segovian Angel"), (4, "Youthful Valkyrie"), (4, "Inspiring Overseer"),
        (3, "Dazzling Angel"), (3, "Thraben Watcher"), (3, "Bishop of Wings"),
        (2, "Angel of Finality"), (2, "Lyra Dawnbringer"), (1, "Sunblast Angel"),
        (2, "Always Watching"), (2, "Night's Whisper"), (2, "Sign in Blood"),
        (1, "Invoke the Divine"), (1, "Day of Judgment"),
    ],
)
