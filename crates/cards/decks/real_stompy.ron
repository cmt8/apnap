// A 60-card deck built only from verified real cards (decisions.md D-038): green ramp into
// big Dinosaurs, with a little red. Needs the Scryfall cache (`harness fetch-cards`).
DeckFile(
    name: "Stompy (real cards)",
    cards: [
        (17, "Forest"), (5, "Mountain"), (2, "Fire Diamond"),
        (4, "Llanowar Elves"), (4, "Elvish Mystic"), (2, "Fyndhorn Elves"),
        (2, "Birds of Paradise"), (4, "Managorger Hydra"), (3, "Beast Whisperer"),
        (4, "Regal Imperiosaur"), (3, "Gigantosaurus"), (2, "Terrian, World Tyrant"),
        (1, "Arasta of the Endless Web"),
        (2, "Harmonize"), (3, "Lightning Bolt"), (1, "Elemental Bond"),
        (1, "Garruk's Uprising"),
    ],
)
