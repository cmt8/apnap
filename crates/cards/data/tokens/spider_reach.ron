// Token definition (CR 111.4: named for its subtype plus "Token"; `key` is what scripts call it): a 1/2 green Spider creature token with reach.
CardScript(
    verified: true,
    tests: ["arasta_makes_spiders_when_opponents_cast_instants_and_sorceries"],
    card: (
        name: "Spider Token",
        key: Some("Spider"),
        token: true,
        colors: Some([Green]),
        card_types: [Creature],
        creature_types: ["Spider"],
        power: Some(1),
        toughness: Some(2),
        keywords: [Reach],
    ),
)
