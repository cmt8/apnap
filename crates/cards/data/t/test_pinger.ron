// {T}: Test Pinger deals 1 damage to any target. A non-mana activated ability (CR 602).
CardScript(
    verified: true,
    tests: ["cr_602_2_activated_ability_uses_stack", "cr_602_5a_summoning_sick_mana_creature"],
    card: (
        name: "Test Pinger",
        mana_cost: Some("{2}{R}"),
        card_types: [Creature],
        creature_types: ["Shaman"],
        power: Some(1),
        toughness: Some(1),
        abilities: [Activated(
            cost: (tap: true),
            body: Effect((
                targets: [AnyTarget],
                effect: DealDamage(to: Target(0), amount: Fixed(1)),
            )),
        )],
    ),
)
