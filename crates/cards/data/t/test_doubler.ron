// If an effect would create one or more tokens under your control, it creates twice that many
// instead. If an effect would put one or more counters on a permanent you control, it puts
// twice that many on it instead.
CardScript(
    verified: true,
    tests: ["cr_614_16_doubler_doubles_tokens_and_counters"],
    card: (
        name: "Test Doubler",
        mana_cost: Some("{2}{G}{G}"),
        card_types: [Enchantment],
        abilities: [
            Replacement(replaces: CreateTokens, with: Twice),
            Replacement(replaces: PutCountersOnYourPermanents, with: Twice),
        ],
    ),
)
