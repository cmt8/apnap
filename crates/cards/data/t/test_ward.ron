    verified: true,
    tests: ["cr_615_7_prevention_shield"],
    card: (
        name: "Test Ward",
        mana_cost: Some("{G}"),
        card_types: [Instant],
        abilities: [Spell(Effect((targets: [AnyTarget], effect: PreventNext(to: Target(0), amount: 3))))],
    ),
)
